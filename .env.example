# --- LLM provider (chat/analysis step) ---
# "anthropic" = Claude native API; "openai_compatible" = any OpenAI-compatible
# chat/completions endpoint (Groq, OpenRouter, Ollama, Together, Gemini compat layer, etc.)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
# llama-3.3-70b-versatile is now Enterprise-only on Groq; gpt-oss-120b is free-tier.
# Verify current free-tier models: https://console.groq.com/docs/models
ANALYSIS_MODEL=openai/gpt-oss-120b
# Keeps each request under Groq free tier's 8000 TPM cap. Lowered after a real run hit
# 8395/8000 tokens: markdown/code-heavy changelogs tokenize ~30-40% denser than a chars/4
# estimate assumes, so these budgets carry extra margin on top of that correction.
MAX_BATCH_TOKENS=1800
# Measured ~2500 real prompt tokens at this batch size, well under the 8000 TPM cap even
# with a generous output allowance below - raised from 1500 after ngx-translate's denser
# changelog produced more change entries than that budget could finish writing out.
LLM_MAX_OUTPUT_TOKENS=4000
# gpt-oss-120b burns max_tokens on hidden reasoning before its final JSON answer;
# "low" keeps most of the output budget for the actual answer instead.
LLM_REASONING_EFFORT=low

# --- Switch back to Anthropic (paid/production) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANALYSIS_MODEL=claude-sonnet-4-6

DATABASE_URL=postgresql+asyncpg://hewg:hewg@localhost:5432/hewg
GITHUB_TOKEN=
OPENAI_API_KEY=            # optional: enables changelog embeddings (separate from LLM_API_KEY above)
EMBEDDING_MODEL=text-embedding-3-small
LOG_LEVEL=INFO
